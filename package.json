{
  "name": "@waffledood/gitty",
  "version": "1.0.0",
  "description": "A TypeScript CLI for interacting with GitHub repositories, issues, and workflows from your terminal.",
  "main": "dist/gitty.cjs",
  "bin": {
    "gitty": "./dist/gitty.cjs"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "esbuild main.ts --bundle --platform=node --outfile=dist/gitty.cjs \"--banner:js=#!/usr/bin/env node\"",
    "prepublishOnly": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waffledood/gitty.git"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/waffledood/gitty/issues"
  },
  "homepage": "https://github.com/waffledood/gitty#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "esbuild": "^0.28.0",
    "semantic-release": "^25.0.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.2",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "octokit": "^5.0.5"
  }
}
